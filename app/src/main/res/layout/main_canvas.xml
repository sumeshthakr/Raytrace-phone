<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <TextView
        android:id="@+id/headerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Raytrace Phone"
        android:textSize="20sp"
        android:textColor="#E0E0FF"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <ImageView
        android:id="@+id/renderCanvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:background="#000010"
        android:contentDescription="Rendered scene output" />

    <TextView
        android:id="@+id/statusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textColor="#90CAF9"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="#16213E">

        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <Spinner
                android:id="@+id/sceneSelector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#0F3460"
                android:popupBackground="#16213E" />

            <Button
                android:id="@+id/startRenderBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="@string/render_action"
                android:backgroundTint="#E94560" />

            <ProgressBar
                android:id="@+id/renderProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feature Toggles"
                android:textColor="#AAAACC"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchShadows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_shadows"
                android:textColor="#CCCCEE"
                android:checked="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchReflect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_reflections"
                android:textColor="#CCCCEE"
                android:checked="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRefract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_refractions"
                android:textColor="#CCCCEE"
                android:checked="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_ambient_occlusion"
                android:textColor="#CCCCEE"
                android:checked="false" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSoftShadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_soft_shadows"
                android:textColor="#CCCCEE"
                android:checked="false" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_antialiasing"
                android:textColor="#CCCCEE"
                android:checked="false" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDoF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_depth_of_field"
                android:textColor="#CCCCEE"
                android:checked="false" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTexturing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_textures"
                android:textColor="#CCCCEE"
                android:checked="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjustable Parameters"
                android:textColor="#AAAACC"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/labelFov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOV: 60"
                android:textColor="#CCCCEE"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sliderFov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="20"
                android:max="120"
                android:progress="60" />

            <TextView
                android:id="@+id/labelBounce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bounces: 4"
                android:textColor="#CCCCEE"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sliderBounce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="1"
                android:max="12"
                android:progress="4" />

            <TextView
                android:id="@+id/labelSamples"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Samples: 1"
                android:textColor="#CCCCEE"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sliderSamples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="1"
                android:max="16"
                android:progress="1" />

            <TextView
                android:id="@+id/labelBright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brightness: 100"
                android:textColor="#CCCCEE"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sliderBright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="10"
                android:max="300"
                android:progress="100" />

            <TextView
                android:id="@+id/labelCamH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cam Height: 50"
                android:textColor="#CCCCEE"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sliderCamH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="0"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/labelCamD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cam Distance: 50"
                android:textColor="#CCCCEE"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sliderCamD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="10"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/labelFocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Focal Len: 50"
                android:textColor="#CCCCEE"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sliderFocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="10"
                android:max="200"
                android:progress="50" />

            <TextView
                android:id="@+id/labelAperture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aperture: 0"
                android:textColor="#CCCCEE"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sliderAperture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="0"
                android:max="100"
                android:progress="0" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
